{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-types",
    "rootDir": ".",
    "strict": true,
    "target": "ES2022",
    "types": [
      "vite/client"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "src",
    "vite.config.ts"
  ],
  "references": [
    {
      "path": "../../packages/protocol"
    }
  ]
}
